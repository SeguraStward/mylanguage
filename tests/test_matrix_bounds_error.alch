// Test de validación de rangos en matrices (debe fallar con índice fuera de rango)
Transmutation GateOfTruth() -> void {
    Transmute("=== TEST DE VALIDACION DE RANGOS - MATRICES ===")
    
    AlchemicMatrix[Solid, 3, 3] matriz
    matriz[0][0] = 1
    matriz[0][1] = 2
    matriz[0][2] = 3
    matriz[1][0] = 4
    matriz[1][1] = 5
    matriz[1][2] = 6
    matriz[2][0] = 7
    matriz[2][1] = 8
    matriz[2][2] = 9
    
    // Este acceso debería causar error: fila 3 fuera de rango [0-2]
    Transmute("Intentando acceder a matriz[3][0] (fuera de rango):")
    Solid valor = matriz[3][0]
    Transmute("Si ves esto, el test FALLO")
}
